{
  "expo": {
    "name": "ERC-RN-APP",
    "slug": "ERC-RN-APP",
    "version": "1.0.0",
    "icon": "./assets/icon-final.png",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "scheme": "ercrnapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jozefkubis.ERCRNAPP",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-final.png",
        "backgroundColor": "#071A2D"
      }
    },
    "web": {
      "output": "static"
    },
    "plugins": ["expo-router"],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f745607-4511-4c71-ae10-b65e2d208d3d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9f745607-4511-4c71-ae10-b65e2d208d3d"
    }
  }
}
